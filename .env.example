# Copy this file to .env. The runner loads it automatically.
# Use the session_id cookie from a currently signed-in browser session.
MYINL_SESSION_ID=

# Optional. Defaults to Europe/Luxembourg.
MYINL_TIMEZONE=Europe/Luxembourg

# Create an application in Pushover to obtain the application API token.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
